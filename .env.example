# Salin berkas ini menjadi .env, lalu isi nilainya.
# Berkas .env sudah masuk .gitignore dan tidak boleh di-commit.

# Token akses Hugging Face untuk memuat pyannote/speaker-diarization-3.1
# Terbitkan di: https://huggingface.co/settings/tokens (izin Read sudah cukup)
# Wajib juga menyetujui syarat model di halaman model pyannote.
HUGGINGFACE_TOKEN=

# Konfigurasi LLM (endpoint yang kompatibel dengan format OpenAI).
# Dipakai untuk DUA hal: penilaian rubrik (evaluator.py) dan koreksi salah
# dengar ASR (text_preprocessing.py).
#
# JANGAN menuliskan kunci sungguhan di berkas ini. Berkas .env.example IKUT
# TER-COMMIT dan repositori ini publik, jadi kunci yang ditulis di sini akan
# terbit ke internet. Isi nilainya di .env (yang sudah masuk .gitignore).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Pengaturan opsional di bawah ini SENGAJA dikomentari.
# Jangan menuliskannya sebagai baris kosong (mis. "DB_PATH="): baris seperti
# itu membuat variabel ADA tetapi bernilai kosong, sehingga nilai default di
# kode tidak terpakai. Untuk DB_PATH akibatnya fatal -- sqlite3 memakai basis
# data sementara yang terhapus sendiri, dan seluruh hasil evaluasi hilang
# meski sistem melaporkan penyimpanan berhasil.
# Biarkan dikomentari untuk memakai default, atau isi dengan nilai sungguhan.
# ---------------------------------------------------------------------------

# Lokasi berkas basis data SQLite. Default: evaluasi.db
# DB_PATH=evaluasi.db

# Ukuran model Whisper: tiny, base, small, medium, large. Default: medium
# Model kecil jauh lebih cepat tetapi transkripsinya kurang akurat. Pakai
# "small" saat mengembangkan, dan PASTIKAN seluruh pengambilan data penelitian
# memakai satu ukuran yang sama -- ukuran model memengaruhi hasil, sehingga
# mencampurnya membuat data tidak dapat dibandingkan. Catat ukurannya di laporan.
# WHISPER_MODEL=medium

# Bahasa rekaman (kode ISO). Default: id
# WHISPER_LANGUAGE=id
